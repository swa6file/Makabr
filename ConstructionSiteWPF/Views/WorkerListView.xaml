<Window x:Class="ConstructionSiteWPF.Views.WorkerListView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Список работников" 
        Height="600" 
        Width="1006"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопки -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Column="0" 
                       Text="Список работников строительной компании"
                       FontSize="18" 
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <!-- Кнопки управления -->
            <StackPanel Grid.Column="1" 
                        Orientation="Horizontal">
                <Button Content="Добавить" 
                        Command="{Binding AddCommand}"
                        Margin="2" 
                        Padding="10,5"
                        ToolTip="Добавить нового работника"
                        MinWidth="80"/>
                <Button Content="Фильтровать" 
                        Command="{Binding FilterCommand}"
                        Margin="2" 
                        Padding="10,5"
                        ToolTip="Фильтровать список работников"
                        MinWidth="80"/>
                <Button Content="Изменить" 
                        Command="{Binding EditCommand}"
                        Margin="2" 
                        Padding="10,5"
                        ToolTip="Изменить выбранного работника"
                        MinWidth="80"/>
                <Button Content="Удалить" 
                        Command="{Binding DeleteCommand}"
                        Margin="2" 
                        Padding="10,5"
                        ToolTip="Удалить выбранного работника"
                        MinWidth="80"/>
                <Button Content="Обновить" 
                        Command="{Binding RefreshCommand}"
                        Margin="2" 
                        Padding="10,5"
                        ToolTip="Обновить список"
                        MinWidth="80"/>
            </StackPanel>
        </Grid>

        <!-- DataGrid со списком работников -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Workers}"
                  SelectedItem="{Binding SelectedWorker}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  RowDetailsVisibilityMode="Collapsed"
                  HeadersVisibility="Column"
                  BorderThickness="1"
                  Margin="0,10,0,10">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" 
                                    Binding="{Binding Id}" 
                                    Width="50"/>
                <DataGridTextColumn Header="Имя" 
                                    Binding="{Binding Name}" 
                                    Width="200"/>
                <DataGridTextColumn Header="Возраст" 
                                    Binding="{Binding Age}" 
                                    Width="80"/>
                <DataGridTextColumn Header="Зарплата" 
                                    Binding="{Binding Salary, StringFormat={}{0:N0} руб.}" 
                                    Width="120"/>
                <!-- УБРАТЬ Converter={StaticResource SpecializationConverter} -->
                <DataGridTextColumn Header="Специализация" 
                                    Binding="{Binding Specialization}" 
                                    Width="150"/>
            </DataGrid.Columns>

            <!-- Стиль для ячеек -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Focusable" Value="True"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <Setter Property="IsTabStop" Value="True"/>
                    <Setter Property="IsEnabled" Value="True"/>
                </Style>
            </DataGrid.CellStyle>

            <!-- Стиль для строк -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="LightGray"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                    <Setter Property="Focusable" Value="True"/>

                    <!-- Подсветка при наведении -->
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFE0E0E0"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FFD0D0D0"/>
                            <Setter Property="BorderBrush" Value="#FF707070"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- Панель информации о выбранном работнике -->
        <Border Grid.Row="2" 
                Background="#FFF0F0F0" 
                Padding="5"
                BorderThickness="0,1,0,0"
                BorderBrush="LightGray">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Выбран работник:" 
                           FontWeight="Bold"
                           Margin="0,0,5,0"/>
                <TextBlock Grid.Column="1" 
                           Text="{Binding SelectedWorker.Name, FallbackValue='не выбран'}"
                           Margin="0,0,10,0"/>

                <TextBlock Grid.Column="2" 
                           Text="ID:" 
                           FontWeight="Bold"
                           Margin="10,0,5,0"/>
                <TextBlock Grid.Column="3" 
                           Text="{Binding SelectedWorker.Id, FallbackValue='-'}"
                           Margin="0,0,10,0"/>

                <TextBlock Grid.Column="4" 
                           Text="Специализация:" 
                           FontWeight="Bold"
                           Margin="10,0,5,0"/>
                <TextBlock Grid.Column="5" 
                           Text="{Binding SelectedWorker.Specialization, FallbackValue='-'}"
                           Margin="0,0,10,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>