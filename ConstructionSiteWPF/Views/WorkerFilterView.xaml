<Window x:Class="ConstructionSiteWPF.Views.WorkerFilterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фильтр работников" 
        Height="350" 
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Фильтр работников"
                   FontSize="16" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <!-- Поля фильтрации -->
        <StackPanel Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Имя -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Имя:" Margin="5"/>
                <TextBox Grid.Row="0" Grid.Column="1" 
                         Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}"
                         Margin="5"/>

                <!-- Минимальный возраст -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Возраст от:" Margin="5"/>
                <TextBox Grid.Row="1" Grid.Column="1" 
                         Text="{Binding MinAge, UpdateSourceTrigger=PropertyChanged}"
                         Margin="5"/>

                <!-- Максимальный возраст -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Возраст до:" Margin="5"/>
                <TextBox Grid.Row="2" Grid.Column="1" 
                         Text="{Binding MaxAge, UpdateSourceTrigger=PropertyChanged}"
                         Margin="5"/>

                <!-- Минимальная зарплата -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Зарплата от:" Margin="5"/>
                <TextBox Grid.Row="3" Grid.Column="1" 
                         Text="{Binding MinSalary, UpdateSourceTrigger=PropertyChanged}"
                         Margin="5"/>

                <!-- Максимальная зарплата -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Зарплата до:" Margin="5"/>
                <TextBox Grid.Row="4" Grid.Column="1" 
                         Text="{Binding MaxSalary, UpdateSourceTrigger=PropertyChanged}"
                         Margin="5"/>

                <!-- Специализация -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Специализация:" Margin="5"/>
                <ComboBox Grid.Row="5" Grid.Column="1" 
          ItemsSource="{Binding SpecializationOptions}"
          SelectedItem="{Binding Specialization, UpdateSourceTrigger=PropertyChanged}"
          Margin="5"/>
            </Grid>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Применить фильтр" 
                    Command="{Binding ApplyFilterCommand}"
                    Margin="5" 
                    Padding="10,5"
                    IsDefault="True"/>
            <Button Content="Очистить фильтр" 
                    Command="{Binding ClearFilterCommand}"
                    Margin="5" 
                    Padding="10,5"/>
            <Button Content="Закрыть" 
                    Command="{Binding CloseCommand}"
                    Click="CloseButton_Click" 
                Margin="5" 
                    Padding="10,5"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>