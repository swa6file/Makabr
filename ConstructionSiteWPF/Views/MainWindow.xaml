<Window x:Class="ConstructionSiteWPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Строительная площадка - Главное меню" 
        Height="400" 
        Width="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Управление строительной площадкой" 
                   FontSize="24" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center" 
                   Margin="0 0 0 30"/>

        <!-- Основные кнопки -->
        <StackPanel Grid.Row="1" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Width="300">

            <Button Content="📋 Список работников" 
                    Command="{Binding ShowWorkerListCommand}"
                    Style="{StaticResource ModernButton}"
                    Margin="0 0 0 10"/>

            <Button Content="🏗️ Информация о стройке"
                    Command="{Binding ShowConstructionInfoCommand}"
                    Style="{StaticResource ModernButton}"
                    Margin="0 0 0 10"/>

            <Button Content="🚪 Выход"
                    Command="{Binding ExitCommand}"
                    Style="{StaticResource ModernButton}"
                    Margin="0 0 0 10"/>
        </StackPanel>

        <!-- Статус -->
        <Border Grid.Row="2" 
                Background="#F0F0F0" 
                CornerRadius="5"
                Padding="10"
                Margin="0 20 0 0">
            <TextBlock Text="{Binding StatusMessage}"
                       HorizontalAlignment="Center"
                       FontStyle="Italic"/>
        </Border>
    </Grid>
</Window>